# Host port mapped to Listmonk (container still listens on 9000).
# Matches the module default baseUrl http://localhost:9002
LISTMONK_PORT=9002

# Super admin created on first `docker compose up` only.
# Changing these later does nothing until `docker compose down -v`.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=listmonktest

# API user created on first install. Token is random; written to creds/api.json.env.
LISTMONK_ADMIN_API_USER=listmonk-api
